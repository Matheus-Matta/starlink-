# Copie para .env e preencha. NUNCA versione o .env.
# Gere os três segredos abaixo com:  npm run admin:bootstrap -- --env .env

# Hash Argon2id da senha do administrador, em base64 (o "$" do hash quebraria o .env).
ADMIN_PASSWORD_HASH_B64=
# Segredo de sessão (>= 32 caracteres aleatórios).
SESSION_SECRET=
# Chave AES-256 dos dados (32 bytes em base64). Guarde uma cópia fora do servidor:
# sem ela, dados e backups ficam ilegíveis. Não troque após gravar dados.
DATA_ENCRYPTION_KEY=

# URL pública (gravada nos QR Codes e tags NFC). Em produção deve ser https://.
PUBLIC_BASE_URL=http://localhost:3000
# Domínio usado pelo Caddy no docker-compose (ex.: placas.suaempresa.com.br).
DOMAIN=

# Opcionais (valores padrão):
# STORAGE_DIR=./storage
# APP_TIME_ZONE=America/Sao_Paulo
# TRUST_PROXY=false            # true somente atrás de proxy reverso (o compose já define)
# SESSION_TTL_HOURS=8
# SESSION_IDLE_MINUTES=60
# STATS_FLUSH_SECONDS=60
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BACKUP_ENCRYPTION_KEY=       # chave separada para backups (32 bytes base64); padrão: DATA_ENCRYPTION_KEY
