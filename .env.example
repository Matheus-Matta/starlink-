# Imagem publicada pelo workflow do GitHub Actions.
# Em produção, prefira fixar uma tag imutável: sha-<commit completo> ou v1.2.3.
APP_IMAGE=ghcr.io/matheus-matta/starlinks:latest

# Domínio público, sem protocolo na primeira variável.
DOMAIN=placas.exemplo.com
# O Compose deriva PUBLIC_BASE_URL=https://DOMAIN para impedir divergência de origem.

# Preenchidos por: npm run admin:bootstrap -- --env .env
ADMIN_PASSWORD_HASH_B64=
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# Opcional: chave distinta para backups. Vazio usa DATA_ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP=14

APP_TIME_ZONE=America/Sao_Paulo
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60
STATS_FLUSH_SECONDS=60

# Limites do Compose; ajuste ao tamanho da VPS e monitore antes de reduzir.
APP_MEMORY_LIMIT=1g
APP_CPU_LIMIT=2.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=1.0
